# ---------------------------------------------------------------------------
# GembyAV portal — environment variables
#
# EVERYTHING HERE IS OPTIONAL. `npm run dev` and a default Vercel deploy both
# work with zero configuration. Add these to upgrade specific behaviours.
#
# Vercel: Project -> Settings -> Environment Variables
# ---------------------------------------------------------------------------

### Sessions -------------------------------------------------------------
# Secret used to sign session cookies and account mirrors. Set this in
# production — without it the app falls back to a development key and the UI
# shows a "Set AUTH_SECRET" warning.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=""

### Chat model -----------------------------------------------------------
# The assistant talks to this Hugging Face model. Leave as-is to use
# Hwiiiiiiii/Gemby-2-agent.
GEMBY_CHAT_MODEL="Hwiiiiiiii/Gemby-2-agent"

# Hugging Face access token (read scope is enough for public models).
# Without a token the portal serves answers from its built-in knowledge base,
# which always works and needs no network.
HF_TOKEN=""

# Optional overrides:
#   HF_ENDPOINT_URL   - point at a dedicated Inference Endpoint, a Space, or a
#                       self-hosted OpenAI-compatible server (vLLM, Ollama...).
#                       e.g. https://YOUR-ENDPOINT.us-east-1.aws.endpoints.huggingface.cloud/v1/chat/completions
#   GEMBY_CHAT_TIMEOUT_MS - per-request timeout, default 20000
HF_ENDPOINT_URL=""
GEMBY_CHAT_TIMEOUT_MS="20000"

### User storage ---------------------------------------------------------
# Without these, accounts live in browser-side demo storage (they work, but
# only in the browser that created them). Adding Upstash Redis makes accounts
# durable and shared across devices — no code change needed.
# Free tier: https://upstash.com  ->  Redis  ->  REST API section
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Where the local JSON user store lives during development. Defaults to
# ./.data inside the app directory.
GEMBYAV_DATA_DIR=""

### Build / release metadata ---------------------------------------------
GEMBYAV_VERSION="1.0.0"
GEMBYAV_REPO="Ghanimsokaki/gemby-software"
GEMBYAV_BRANCH="main"

# Absolute path to the installer if it is not at the repo root.
GEMBYAV_EXE_PATH=""

### Site -----------------------------------------------------------------
# Canonical origin, used for metadata/OG tags. On Vercel this is derived
# automatically, so you only need it for self-hosting.
NEXT_PUBLIC_SITE_URL=""
